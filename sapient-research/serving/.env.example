# Copy to .env (gitignored) and adjust. NEVER commit real secrets.

# Engine: "mock" (default, no GPU/weights) or "real" (GPU box with the sapient1 pkg + checkpoint).
SAPIENT_ENGINE=mock

# Which checkpoint the real engine loads (HF id). Ignored in mock mode.
SAPIENT_MODEL_ID=The-Sapient-Company/sapient-1-llama
SAPIENT_MODEL_VERSION=sapient-1-llama@mock

# Path to the hashed-key store created by scripts/issue_key.py. Only hashes live here.
SAPIENT_KEYS_FILE=keys.json

# Abuse / anti-extraction controls (per client).
SAPIENT_RATE_LIMIT_PER_MIN=12
SAPIENT_DAILY_QUOTA=200

# Data minimization: how long a result is retrievable before it's purged (seconds).
SAPIENT_RESULT_TTL=900

# Upload guardrails.
SAPIENT_MAX_UPLOAD_MB=200

# IP posture: never return the full 1000-dim parcel vector by default (only per-client opt-in).
SAPIENT_INCLUDE_FULL_PARCELS=0

# Expose Swagger docs? Off by default in prod.
SAPIENT_DOCS=0

# Secret pulled from Modal's secret store on the deploy box (NOT set here in plaintext).
# HF_TOKEN=...
